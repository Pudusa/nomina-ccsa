# Configuración del Entorno para Docker Compose - Nomina CCSA
# Copiar a .env y sustituir TODOS los valores por secretos reales.
PORT=4000
AUTH_PORT=3001
JWT_SECRET=cambiar_por_un_valor_aleatorio_largo
SEED_ADMIN_PASSWORD=cambiar
SEED_EDITOR_PASSWORD=cambiar
SEED_VIEWER_PASSWORD=cambiar

# Relojes ZKTeco (opcional): la hora y los equipos se configuran desde el panel de administrador.
# Estas variables solo son un respaldo cuando aún no hay equipos guardados en la BD.
# ZK_DEVICES=[{"ip":"192.168.107.13","commKey":0,"name":"Reloj 1"}]
ZK_DEVICES=
ZK_IP=
ZK_PORT=4370
ZK_COMM_KEY=0
